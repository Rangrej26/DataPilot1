# DataPilot AI Environment Configuration Example
# Copy this file to .env and configure your optional keys

# Server Settings
HOST=127.0.0.1
PORT=8000
APP_ENV=development
MAX_UPLOAD_SIZE_MB=50

# Optional LLM API Keys (App operates 100% offline using deterministic computation if not configured)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
